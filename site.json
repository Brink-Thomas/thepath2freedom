                { "id": "b_moz2c", "type": "text", "colSpan": 12, "data": { "html": "<h3>Kerngegevens</h3><ul><li>Titel: Mozaïek</li><li>Genre: verhalenbundel</li><li>Verschenen: 2020</li></ul>" } }
